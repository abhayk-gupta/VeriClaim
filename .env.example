# ── Application ───────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change_me_in_production
BASE_URL=https://your-domain.ngrok-free.app

# ── Database ──────────────────────────────────────────
# Local Docker (default):
DATABASE_URL=postgresql+asyncpg://vericlaim:secret@db:5432/vericlaim
# Neon.tech (production):
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Redis ─────────────────────────────────────────────
# Local Docker (default):
REDIS_URL=redis://redis:6379/0
# Upstash (production):
# REDIS_URL=rediss://:password@xxx.upstash.io:6380

# ── Celery ────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Google Gemini ─────────────────────────────────────
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash-lite-preview-06-17

# ── Twilio ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxxxx
TWILIO_PHONE_NUMBER=+15005550006
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── Meta WhatsApp Cloud API ───────────────────────────
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_BUSINESS_ACCOUNT_ID=0987654321
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxx
WHATSAPP_VERIFY_TOKEN=vericlaim_secret_2024
WHATSAPP_API_VERSION=v20.0

# ── Cloudflare R2 (permanent media storage) ───────────
CLOUDFLARE_R2_ENDPOINT=https://{account_id}.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=xxxxxxx
CLOUDFLARE_R2_SECRET_KEY=xxxxxxx
CLOUDFLARE_R2_BUCKET=vericlaim-media

# ── Ngrok ─────────────────────────────────────────────
NGROK_AUTHTOKEN=xxxxxxx
NGROK_STATIC_DOMAIN=your-free-domain.ngrok-free.app

# ── Whisper ───────────────────────────────────────────
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# ── Piper TTS ─────────────────────────────────────────
PIPER_MODEL_PATH=audio/en_US-lessac-medium.onnx
PIPER_VOICE=en_US-lessac-medium

# ── Feature Flags ─────────────────────────────────────
# true = Twilio WhatsApp sandbox (dev), false = Meta Cloud API (prod)
USE_TWILIO_WHATSAPP=true
# true = use local Whisper for STT, false = use Twilio <Gather> STT (faster)
USE_LOCAL_WHISPER=false
